{
  "name": "tracklite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "NODE_OPTIONS=--conditions=react-server drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "NODE_OPTIONS=--conditions=react-server drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "db:seed:load": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-load.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/reset.ts && npm run db:seed",
    "setup": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/setup.ts",
    "email:dev": "tsx --conditions=react-server --env-file=.env.local scripts/send-dev-email.ts",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/worker.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.13.0",
    "drizzle-orm": "^0.45.3",
    "fractional-indexing": "^4.0.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css.escape": "^1.5.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}