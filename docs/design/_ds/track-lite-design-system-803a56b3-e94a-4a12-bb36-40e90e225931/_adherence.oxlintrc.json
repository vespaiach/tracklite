{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/dialogs/**",
              "components/forms/**",
              "components/glyphs/**",
              "components/issue/**",
              "components/overlays/**",
              "components/popover/**",
              "components/shell/**",
              "components/views/**",
              "ui_kits/track-lite/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|JetBrains Mono|Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: Archivo, JetBrains Mono, Source Serif 4."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:collapsed|rail|children|className|style|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: collapsed, rail, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|block|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevation|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevation."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Card> elevation must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Command'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|path|icon|keys|run|key|ref|className|style|children)$/]",
        "message": "<Command> doesn't accept that prop. Declared props: id, label, path, icon, keys, run."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|actions|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, children, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|error|children|className|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, error, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:duotone|bold|regular)$/]",
        "message": "<Icon> weight must be one of 'duotone' | 'bold' | 'regular'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IssueLayout'] > JSXAttribute > JSXIdentifier[name!=/^(?:main|side|key|ref|className|style|children)$/]",
        "message": "<IssueLayout> doesn't accept that prop. Declared props: main, side."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|checked|priority|id|status|title|end|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: selected, checked, priority, id, status, title, end, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|children|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: brand, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: kind."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:id|status|project|cycle|label|est|ai|sync)$/]",
        "message": "<Pill> kind must be one of 'id' | 'status' | 'project' | 'cycle' | 'label' | 'est' | 'ai' | 'sync'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:done|active|todo|large|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: done, active, todo, large."
      },
      {
        "selector": "JSXOpeningElement[name.name='Choice'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Choice> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Status'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|large|className|key|ref|className|style|children)$/]",
        "message": "<Status> doesn't accept that prop. Declared props: status, large, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|accent-2|neutral|outline)$/]",
        "message": "<Tag> variant must be one of 'accent' | 'accent-2' | 'neutral' | 'outline'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
